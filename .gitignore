# Python (tools/, test automation)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Logs and captures
*.log
*.csv
!docs/**/*.csv

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
